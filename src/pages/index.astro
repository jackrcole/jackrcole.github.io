---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hello, I'm</div>
    <div class="text-5xl font-bold">John Cole</div>
    <div class="text-3xl py-3 font-bold">AI Researcher & Embedded Software Engineer</div>
    <div class="py-2">
      <text class="text-lg">
        Master's student specializing in multi-agent reinforcement learning, autonomous systems, and hardware-accelerated physics stacks like JAX. Building robust, scalable systems that bridge advanced artificial intelligence with real-world deployment.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://linkedin.com/in/john-c-a90583100" target="_blank">Let's connect!</a>
      <a href="https://github.com/jackrcole" target="_blank" class="btn btn-outline ml-5">
        View GitHub
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Featured Projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="Language-Guided Differentiable Predicted Control"
    img="/post_img.webp"
    desc="A specialized framework integrating natural language guidance with differentiable model predictive control for autonomous systems."
    url="#"
    badge="RESEARCH"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="JAX Computational Physics Modeling"
    img="/post_img.webp"
    desc="High-performance simulation pipelines leveraging JAX for hardware-accelerated differentiable physics stacks and multi-agent systems."
    url="#"
    badge="JAX"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Embedded Systems & Threat Detection"
    img="/post_img.webp"
    desc="Optimized software engines and threat detection modules focusing on low-latency execution and hardware integration."
    url="#"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest publications & write-ups</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>