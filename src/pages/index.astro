---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hello, I'm</div>
    <div class="text-5xl font-bold">John Cole</div>
    <div class="text-3xl py-3 font-bold">AI Researcher & Embedded Software Engineer</div>
    <div class="py-2">
      <text class="text-lg">
        Master's student specializing in multi-agent reinforcement learning, autonomous systems, and hardware-accelerated physics stacks like JAX. Building robust, scalable systems that bridge advanced artificial intelligence with real-world deployment.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://linkedin.com/in/jack-c-a90583100" target="_blank">Let's connect!</a>
      <a href="https://github.com/jackrcole" target="_blank" class="btn btn-outline ml-5">
        View GitHub
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Featured Projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="Language-Guided Differentiable Predictive Control"
    img="/projects/lg-dpc.png"
    desc="A specialized framework integrating natural language guidance with differentiable model predictive control for autonomous systems."
    url="#"
    badge="RESEARCH"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Social Dilemmas in JAX-based Multi-Agent Reinforcement Learning"
    img="/projects/social-jax.png"
    desc="High-throughput simulation and analysis of cooperative and competitive dynamics in social dilemma environments (Coin Game) using JAX and JaxMARL with MAPPO and IPPO."
    url="#"
    badge="JAX / MARL"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Embedded Systems & Threat Detection"
    img="/projects/origin.png"
    desc="Optimized software engines and threat detection modules focusing on low-latency execution and hardware integration."
    url="#"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest publications</div>
  </div>

  <HorizontalCard
    title="Multimodal Agentic Model Predictive Control"
    img="/projects/agent-mpc.png"
    desc="Integrating Model Predictive Control (MPC) with Multimodal Vision-Language Models (VLMs) to enable context-aware, safety-centric scene understanding and planning for autonomous vehicles. Published at AAMAS 2025."
    url="#"
    badge="AAMAS 2025"
  />
</BaseLayout>