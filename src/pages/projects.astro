---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Research & Publications</div>
  </div>

  <HorizontalCard
    title="Multimodal Agentic Model Predictive Control"
    img="/projects/agent-mpc.png"
    desc="Published at the 24th ACM Conference on Autonomous Agents and Multiagent Systems (AAMAS), 2025. Co-authored with Saptarashmi Bandyopadhyay, Thomas Goldstein, and David Jacobs."
    url="#"
    badge="AAMAS 2025"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Autonomous Vehicle VLA Models"
    img="/projects/thesis.png"
    desc="Post-training Vision-Language-Action models using multi-agent rewards to incentivize safe driving behaviors and zero-shot coordination."
    url="#"
    badge="THESIS"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Applied AI & Systems Projects</div>
  </div>

  <HorizontalCard
    title="Multi-Agent Recommender Systems for XAI"
    img="/projects/ma-recsys.png"
    desc="Applied Multi-Agent Reinforcement Learning methods to develop Recommender Systems for Explainable AI with integrated human feedback."
    url="#"
    badge="MARL"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="MASIMU: Multi-Agent Interpretable Machine Unlearning"
    img="/projects/ma-unlearning.png"
    desc="Trained models to selectively forget targeted datasets while preserving performance using LIME and interpretability frameworks."
    url="#"
    badge="AI SAFETY"
  />
  <!-- <div class="divider my-0"></div>
  <HorizontalCard
    title="XAI on Automatic Generation of Poetry"
    img="/post_img.webp"
    desc="Investigated structural output patterns of Google's Fine-tuned Language Net (FLAN) using interpretability tools like InSeq."
    url="#"
  /> -->
</BaseLayout>